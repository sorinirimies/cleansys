#!/usr/bin/env nu
# ── CleanSys · test_gen_content_packs.nu ────────────────────────────
# The generated cleaner packs (browsers/apps/games.toml) must match the generator, so a
# hand edit to them can never be silently lost by the next `just gen-packs`.

use std/assert
use runner.nu *
use ../gen_content_packs.nu [render stale_files]

def builtin []: nothing -> string {
    $env.CURRENT_FILE | path dirname | path join ".." ".." "crates" "cleansys-core" "src" "engine" "builtin"
}

def "test gen_content_packs: renders all three packs with the generated header" [] {
    let r = (render)
    assert equal ($r | columns | sort) ["apps.toml" "browsers.toml" "games.toml"]
    for f in ($r | columns) {
        assert ($r | get $f | str starts-with "# GENERATED by scripts/gen_content_packs.nu")
    }
}

def "test gen_content_packs: the committed packs are up to date" [] {
    assert equal (stale_files (render) (builtin)) []
}

def "test gen_content_packs: a hand edit or a missing file is reported" [] {
    let tmp = (mktemp -d)
    let r = (render)
    for f in ($r | columns) { $r | get $f | save -f ($tmp | path join $f) }
    assert equal (stale_files $r $tmp) []
    "# hand edit\n" | save --append ($tmp | path join "apps.toml")
    rm ($tmp | path join "games.toml")
    assert equal (stale_files $r $tmp | sort) ["apps.toml" "games.toml"]
    rm -rf $tmp
}

def main [] { run-tests }
